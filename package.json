{
  "name": "brandon-portfolio-spirit-terminal",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch --import tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node --import tsx server/index.ts",
    "start": "node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/server.test.ts",
    "test:browser": "node --import tsx scripts/browser-check.mjs && node --import tsx scripts/intro-check.mjs && node --import tsx scripts/showcase-check.mjs",
    "postbuild": "node scripts/compress-assets.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "4.23.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "packageManager": "npm@10.9.2"
}
